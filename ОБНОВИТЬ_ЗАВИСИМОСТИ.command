#!/bin/bash
# Скрипт для создания/обновления виртуального окружения и зависимостей (macOS)
# Файл: ОБНОВИТЬ_ЗАВИСИМОСТИ.command
# Запуск: Дважды кликните на файл (откроется в терминале)

# Переходим в директорию скрипта
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$SCRIPT_DIR" || exit 1

# Запускаем основной скрипт
exec "$SCRIPT_DIR/ОБНОВИТЬ_ЗАВИСИМОСТИ.sh"

